// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  policies  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model StudentApplication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Document checklist
  hasPassport                    Boolean @default(false)
  hasCopiesOfAcademicOfHome      Boolean @default(false)
  hasCopiesOfAcademicOfAustralia Boolean @default(false)
  hasCurrentCOE                  Boolean @default(false)
  hasQTEassessmentForm           Boolean @default(false)
  hasCurriculumVitae             Boolean @default(false)
  references                     String?
  currentLocation                String?
  applicationType                String?

  // Personal Information
  title        String?
  givenName    String
  middleName   String?
  familyName   String
  dateOfBirth  DateTime?
  emailAddress String
  mobile       String?
  homePhone    String?

  // Address
  streetNumber  String?
  streetName    String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?

  // Citizenship & Visa
  countryOfCitizenship String?
  passportNumber       String?
  visaNumber           String?

  // English Proficiency
  ielts      String?
  dateOfTest DateTime?

  // Additional Personal Info
  gender                           String?
  countryOfBirth                   String?
  cityOfBirth                      String?
  austCitizenshipStatus            String?
  aboriginalOrTorresStraitIslander String?
  employmentStatus                 String?
  doSpeakEnglishAtHome             Boolean?
  requireEnglishAssisance          Boolean?
  higheshtSchoolEducation          String?
  yearCompleted                    String?
  disabilities                     String?
  priorEducation                   String?

  // Contact & Emergency
  alternateEmailAddress    String?
  usi                      String?
  emergencyContactName     String?
  emergencyRelationship    String?
  emergencyPhonNumber      String?
  emergencyContactComments String?

  // Course Information
  qualificationLocation         String?
  intakeDate                    DateTime?
  isApplyingForCreditTransfer   Boolean?  @default(false)
  isApplyingForRecognitionOfRPL Boolean?  @default(false)
  courses                       String[]

  // OSHC Information
  oshcType             String?
  oshcProviderName     String?
  oschMembershipNumber String?
  oschExpiryDate       DateTime?

  // Language & Literacy Assessment
  iCan                     Boolean? @default(false)
  isMyFirstLang            Boolean? @default(false)
  canReadTimeOnClock       Boolean? @default(false)
  isMyFirstlang2           Boolean? @default(false)
  canAddUpThings           Boolean? @default(false)
  isMyFirstLang3           Boolean? @default(false)
  canKnowHowMuchChange     Boolean? @default(false)
  isMyFirstLang4           Boolean? @default(false)
  canUsePhone              Boolean? @default(false)
  isMyFirstLang5           Boolean? @default(false)
  canTakePhoneMessage      Boolean? @default(false)
  isMyFirstLang6           Boolean? @default(false)
  canFillAFormForTimesheet Boolean? @default(false)
  isMyFirstLang7           Boolean? @default(false)
  canFollowInstructions    Boolean? @default(false)
  isMyFirstLang8           Boolean? @default(false)

  // Previous Attendance & Agreements
  haveAttendedAUSCBefore  Boolean? @default(false)
  agreeToBeContacted      Boolean? @default(false)
  agreeTermsAndConditions Boolean? @default(false)

  // Signature
  fullName  String?
  signature String?

  // Agent Information
  agentName    String?
  agentEmail   String?
  businessName String?
  studentType  String?

  @@map("studentApplication")
}

model AgentRegistration {
  id                             String    @id @default(cuid())
  businessType                   String?
  legalName                      String?
  tradingName                    String?
  ownerName                      String?
  placeOfRegistration            String?
  dateOfRegistration             DateTime?
  businessNumber                 String?
  maraNo                         String?
  qeacNo                         String?
  representingCountries          String?
  ceoName                        String?
  email                          String?
  mobile                         String?
  landline                       String?
  contactPerson                  String?
  contactPersonEmail             String?
  contactPersonMobile            String?
  contactPersonLandline          String?
  headOfficeAddress              String?
  website                        String?
  numberOfBranches               String?
  locationOfBranches             String?
  coursesInterrestedIn           String?
  nameOfIndustrialBody           String?
  yearOfMembership               String?
  institutionName                String?
  yearOfAffiliation              String?
  numberOfStudents               String?
  firstYearIntakes               String?
  sudentSupportType              String?
  feesChargeDescription          String?
  additionalInformationMarketing String?
  standardFourCompliance         Boolean?  @default(false)
  pierAccreditation              Boolean?  @default(false)
  EsosAct                        Boolean?  @default(false)
  studentOnBoardingPurpose       Boolean?  @default(false)
  auscMarketingCompliance        Boolean?  @default(false)
  auscMarketingMaterial          Boolean?  @default(false)
  refereeOne                     String?
  refereeContactNumber           String?
  organization                   String?
  position                       String?
  refereeEmailAddress            String?
  refereeTwo                     String?
  refereeTwoContactNumber        String?
  refereeTwoOrganization         String?
  refereeTwoPosition             String?
  refereeTwoEmailAddress         String?
  authorizedPersonName           String?
  authorizedPersonPosition       String?
  signature                      String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  @@map("agentRegistration")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contactUs")
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String?  @unique
  excerpt     String
  aiOverview  String?
  content     String
  author      String   @default("AuSC Admissions")
  date        String?
  image       String
  category    String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogs")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  policies  String[]
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}


